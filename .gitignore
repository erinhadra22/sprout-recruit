# Source-only repository. Everything is private/untracked unless allowed below.
*
!/.gitignore
!/README.md
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/docs/
!/docs/PRODUCTION-READINESS-AUDIT.md
!/docs/PILOT-DECISIONS.md
!/docs/CODEX-INSTALL.md
!/docs/SECOND-MAC-ACCEPTANCE.md
!/app/
!/app/build.sh
!/app/test.sh
!/app/install-local.sh
!/app/installer.py
!/app/Tests/installer_test.py
!/app/package-release.sh
!/app/Sources/
!/app/Sources/*.swift
!/app/Web/
!/app/Web/*.js
!/app/Web/*.css
!/app/Web/*.html
!/app/Tests/
!/app/Tests/*.cjs
!/app/Assets/
!/app/Assets/*.svg
!/app/Assets/*.png
!/app/Assets/*.icns
!/app/Assets/*.swift
!/app/Assets/README.md
!/app/Assets/AppIcon.iconset/
!/app/Assets/AppIcon.iconset/*.png
# Separate, unverified iPhone pilot: source only; regenerate Xcode project locally.
!/app/MobilePilot/
!/app/MobilePilot/README.md
!/app/MobilePilot/Info.plist
!/app/MobilePilot/check_local.sh
!/app/MobilePilot/fetch_recording.py
!/app/MobilePilot/create_project.py
!/app/MobilePilot/Sources/
!/app/MobilePilot/Sources/*.swift
!/app/MobilePilot/Tests/
!/app/MobilePilot/Tests/*.swift
!/app/MobilePilot/Tests/*.py
# Explicit defense against accidental broadening. Do not force-add these.
**/Data/
**/backups/
**/handoff/
**/benchmark*/
**/.agents/
**/.codex/
**/*.sqlite*
**/*.db
**/*.csv
**/*.tsv
**/*.json
**/*.jsonl
**/*.app/
**/*.xcodeproj/
**/*.xcworkspace/
**/xcuserdata/
**/DerivedData/
**/.env*
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.mobileprovision
**/*.provisionprofile
**/.DS_Store
/app/.local-signing-identity

!app/Assets/SproutRecruit.entitlements
